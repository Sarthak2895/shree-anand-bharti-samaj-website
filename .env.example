NEXT_PUBLIC_SITE_URL=https://shree-anand-bharti-samaj-website.vercel.app

# Supabase project URL, e.g. https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (or legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (or legacy service_role key).
# NEVER prefix this with NEXT_PUBLIC_ and never expose it in browser code.
SUPABASE_SECRET_KEY=

# Exact email address of the single administrator allowed to approve Gallery images.
# Create this user in Supabase -> Authentication -> Users.
ADMIN_EMAIL=

# Official social profiles. Leave blank until approved.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
